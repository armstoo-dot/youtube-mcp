# Copy to ~/.config/youtube-mcp/.env (or $YOUTUBE_MCP_HOME/.env) and chmod 600.
# Never commit real values.
YOUTUBE_CLIENT_ID=your-desktop-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
# Optional
# YOUTUBE_MCP_HOME=~/.config/youtube-mcp      # tokens + quota ledger live here
# YOUTUBE_MCP_GROUPS=read,write               # add ,danger to expose publish/delete tools
# YOUTUBE_DAILY_QUOTA=10000
# YOUTUBE_QUOTA_RESERVE=500
# YOUTUBE_AUTH_PORT=53682
